lane :huawei_upload do
  # the AAB artifact from build-aab lands in the project root
  aab_path = Dir.glob(File.expand_path("../app-*.aab", __dir__)).first
  UI.user_error!("No AAB file found!") unless aab_path
  UI.message("Using AAB file = #{aab_path}")

  huawei_appgallery_connect(
    client_id: ENV["HUAWEI_CLIENT_ID"],
    client_secret: ENV["HUAWEI_CLIENT_SECRET"],
    app_id: ENV["HUAWEI_APP_ID"],
    apk_path: aab_path,
    is_aab: true,
    submit_for_review: false,
  )
end
